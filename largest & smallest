let arr = [1, 2, 3, 4, 5];

let lar = arr[0];   // start with the first element
let small = arr[0];

for (let i = 1; i < arr.length; i++) {   // start from index 1
  if (arr[i] > lar) {
    lar = arr[i];
  }
  if (arr[i] < small) {
    small = arr[i];
  }
}

console.log("Largest:", lar);   // 5
console.log("Smallest:", small); // 1
