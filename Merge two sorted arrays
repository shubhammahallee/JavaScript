//Merge two sorted arrays.

let arr0 = [1, 3, 5];
let arr1 = [2, 4, 6];

let sum = [];
let i = 0;
let j = 0;

while (i < arr0.length && j < arr1.length) {
  if (arr0[i] < arr1[j]) {
    sum.push(arr0[i]);
    i++;
  } else {
    sum.push(arr1[j]);
    j++;
  }
}

while (i < arr0.length) {
  sum.push(arr0[i]);
  i++;
}

while (j < arr1.length) {
  sum.push(arr1[j]);
  j++;
}

console.log(sum);
